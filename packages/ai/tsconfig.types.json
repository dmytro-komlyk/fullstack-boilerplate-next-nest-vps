{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,

    "declaration": true,
    "declarationMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo.types",
    "composite": false,

    "paths": {
      "@package/prisma": ["../prisma/dist/index.d.ts"],
      "@package/prisma/*": ["../prisma/dist/*"]
    }
  },
  "include": ["src/**/*", "../../types/globals.d.ts"]
}
